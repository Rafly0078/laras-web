# Konfigurasi LARAS — salin jadi `.env.local` untuk pengembangan lokal.
#
# Semua nilai di sini OPSIONAL: app punya default yang jalan tanpa satu pun
# variabel diset. Yang tidak opsional adalah NEXT_PUBLIC_SITE_URL di produksi —
# tanpa itu, kartu bagikan dan URL kanonik menunjuk ke localhost.

# Alamat publik aplikasi, tanpa garis miring di akhir.
# Dipakai `metadataBase`, og:url, dan canonical.
# Produksi WAJIB menyetel ini.
NEXT_PUBLIC_SITE_URL=https://laras.example.com

# Basis relay katalog Apple Music (Lyricsflow).
# Kosongkan untuk memakai default https://api.spicyamll.online
# Diganti hanya kalau host relaynya berpindah.
# APPLE_CATALOG_BASE=https://api.spicyamll.online

# Membuka rute pengembangan `/demo` dan `/dev/lirik` pada build produksi.
#
# JANGAN diset di produksi. Rute itu menyajikan lirik lengkap empat lagu dari
# TTML yang ikut di-commit — teks berhak cipta penerbit, bukan data teknis.
# Satu-satunya alasan menyalakannya adalah menjalankan harness CDP terhadap
# build produksi (lihat HANDOFF.md §7):
#
#   LARAS_ENABLE_DEV=1 npm run build && npx next start -p 3210
#
# LARAS_ENABLE_DEV=1
